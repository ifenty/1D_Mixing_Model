        "minutes_lost": 15
      },
      {
        "category": "documentation_coverage",
        "summary": "The two *_VALIDATION_RESULTS.md files, which carry the measured known-gap figures the tests cite, were outside the doc_contract inventory. The sealed documentation report therefore could not cover the passages that were wrong, and the reviewer had to re-read them manually.",
        "evidence": "Richard round-2 documentation_review notes and limits: VALIDATION_RESULTS.md outside the inventory",
        "minutes_lost": 5
      }
    ],
